{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "office:assets": "node scripts/fetch-office-assets.mjs",
    "office:character-guard": "node scripts/check-office-character-production.mjs",
    "predev": "npm run office:assets && npm run office:furniture-assets && npm run office:character-guard",
    "prebuild": "npm run office:pilot-clean && npm run office:assets && npm run office:furniture-assets && npm run office:character-guard",
    "preoffice:shots": "npm run office:assets && npm run office:furniture-assets && npm run office:character-guard",
    "office:shots": "node scripts/capture-office-shots.mjs",
    "office:shots:install": "playwright install chromium",
    "preoffice:browser-qa": "npm run office:assets && npm run office:furniture-assets && npm run office:character-guard",
    "office:browser-qa": "node scripts/capture-office-browser-qa.mjs",
    "office:browser-qa:install": "playwright install chromium firefox webkit",
    "office:debug:prod-check": "node scripts/check-office-debug-production.mjs",
    "office:pilot-assets": "npm run office:furniture-assets",
    "office:pilot-clean": "node scripts/clean-office-pilot-assets.mjs",
    "preoffice:pilot-shots": "npm run office:assets && npm run office:furniture-assets && npm run office:character-guard",
    "office:pilot-shots": "node scripts/capture-office-shots.mjs --pilot",
    "office:furniture-assets": "node scripts/fetch-office-furniture-assets.mjs",
    "preoffice:renderer-shots": "npm run office:assets && npm run office:furniture-assets && npm run office:character-guard",
    "office:renderer-shots": "node scripts/capture-office-renderer-pilot.mjs",
    "office:production-r3f-smoke": "node scripts/check-office-r3f-production.mjs",
    "office:probe:camera-drift": "node scripts/probe-office-camera-drift.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "@react-three/fiber": "9.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "@types/three": "^0.181.0",
    "playwright": "^1.63.0"
  }
}